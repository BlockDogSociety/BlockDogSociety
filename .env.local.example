NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 3 — server-only, never exposed to the browser.
# Settings -> API -> service_role key (NOT the anon key). Bypasses RLS —
# used for the admin panel and the Stripe webhook.
SUPABASE_SERVICE_ROLE_KEY=

# Your own email, so only you can access /admin and its actions.
ADMIN_EMAIL=

# Stripe Dashboard -> Developers -> API keys (use the TEST keys while building).
STRIPE_SECRET_KEY=
# Stripe Dashboard -> Developers -> Webhooks (or `stripe listen` locally) -> signing secret.
STRIPE_WEBHOOK_SECRET=
# Price of one calendar, in cents.
CALENDAR_PRICE_CENTS=2500

# Resend Dashboard -> API Keys.
RESEND_API_KEY=
# Must be from a domain you've verified in Resend, or leave unset to use
# their shared test sender (onboarding@resend.dev — fine for now).
RESEND_FROM_EMAIL=
